# =====================================================
# COURSE-ON-PROMPT ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# =====================================================

# =====================================================
# DATABASE PROVIDER SELECTION
# =====================================================
# Supported values: 'airtable', 'azure-sql', 'cosmos-db', 'postgresql', 'mongodb'
# Default: 'airtable'
DB_PROVIDER=airtable

# =====================================================
# AIRTABLE CONFIGURATION (DB_PROVIDER=airtable)
# =====================================================
# Get your Airtable API credentials from: https://airtable.com/account

# Airtable API Key
airtable_api=your_airtable_api_key_here

# Airtable Personal Access Token (required for certain operations)
personal_access_token=your_personal_access_token_here

# Airtable Base IDs
student_base=your_student_base_id_here
course_base=your_course_base_id_here
alfred_base=your_alfred_base_id_here
internal_course_base=your_internal_course_base_id_here
alfred_waitlist_base=your_alfred_waitlist_base_id_here

# Airtable Table Names
student_table=Student
alfred_table=Alfred

# =====================================================
# AZURE SQL CONFIGURATION (DB_PROVIDER=azure-sql)
# =====================================================
# Azure SQL Database credentials
# Get these from Azure Portal > SQL Database > Connection strings

# Azure SQL Server (e.g., your-server.database.windows.net)
AZURE_SQL_SERVER=your-server.database.windows.net

# Azure SQL Database name
AZURE_SQL_DATABASE=course-on-prompt-db

# Azure SQL Username
AZURE_SQL_USER=your_username

# Azure SQL Password
AZURE_SQL_PASSWORD=your_password

# =====================================================
# MONGODB CONFIGURATION (Current chat log storage)
# =====================================================
# MongoDB Atlas credentials

# MongoDB username
MONGOUSER=your_mongodb_username

# MongoDB password
MONGOPASSWORD=your_mongodb_password

# MongoDB connection string (optional - constructed from above if not provided)
# MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/

# =====================================================
# OPENAI CONFIGURATION
# =====================================================
# OpenAI API credentials for AI-powered features

# OpenAI API Key
apiKey=your_openai_api_key_here

# OpenAI Organization Key (optional)
orgKey=your_openai_org_key_here

# =====================================================
# AZURE COSMOS DB CONFIGURATION (DB_PROVIDER=cosmos-db)
# =====================================================
# Azure Cosmos DB credentials (for future implementation)

# COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
# COSMOS_DB_KEY=your_cosmos_db_key_here
# COSMOS_DB_DATABASE=course-on-prompt

# =====================================================
# POSTGRESQL CONFIGURATION (DB_PROVIDER=postgresql)
# =====================================================
# PostgreSQL database credentials (for future implementation)

# PG_HOST=your-postgresql-host.com
# PG_PORT=5432
# PG_DATABASE=course_on_prompt
# PG_USER=your_pg_username
# PG_PASSWORD=your_pg_password
# PG_SSL=true

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================

# Server Port
PORT=3000

# Node Environment (development, production, test)
NODE_ENV=development

# =====================================================
# MIGRATION SETTINGS
# =====================================================

# Enable migration mode (set to 'true' when migrating between databases)
MIGRATION_MODE=false

# Source database for migration (e.g., 'airtable')
MIGRATION_SOURCE=airtable

# Target database for migration (e.g., 'azure-sql')
MIGRATION_TARGET=azure-sql

# =====================================================
# LOGGING AND MONITORING
# =====================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable database query logging
LOG_QUERIES=false

# =====================================================
# NOTES
# =====================================================
# 1. After copying this file to .env, fill in your actual values
# 2. Never commit the .env file to version control
# 3. Keep your credentials secure and rotate them regularly
# 4. For production, use Azure Key Vault or similar secret management
# 5. Ensure DB_PROVIDER matches your active configuration section
# =====================================================
